NODE_ENV=development
PORT=3000
# PostgreSQL 17 trên máy bạn (pgAdmin) - database: vietjet_booking
DATABASE_URL=postgresql://postgres:MAT_KHAU_POSTGRES@localhost:5432/vietjet_booking
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8081,http://localhost:19006,http://localhost:8090,http://192.168.1.5:3000,http://192.168.1.5:8081,http://192.168.1.5:19006,http://192.168.1.5:8090
# Địa chỉ website khách hàng (frontend riêng). VNPAY xong sẽ chuyển khách về đây. Để trống nếu backend và web cùng origin.
WEB_URL=http://192.168.1.5:8081
# Mặc định cho phép thêm mọi origin localhost / mạng LAN (Expo Web cổng 8081, điện thoại thật...). Đặt false khi chạy production thật.
CORS_ALLOW_LOCAL=true
# Vé đã thanh toán chỉ hủy được khi còn ít nhất N ngày trước giờ bay (0 = không giới hạn)
CANCEL_MIN_DAYS=10
DB_SSL=false
# UC-00 Auth (mới)
REFRESH_TOKEN_TTL_DAYS=30
STAFF_DEFAULT_PASSWORD=Vietjet@123

# ---------- OTP ----------
# OTP_DELIVERY=backend (mặc định, dùng khi chưa có SMS) -> mã OTP được giao về BACKEND: lưu DB, in ra log server
#                       và trả kèm `devOtp` để web/mobile tự hiển thị / điền sẵn. KHÔNG dùng khi chạy thật.
# OTP_DELIVERY=sms     -> backend gửi mã thẳng tới điện thoại khách qua nhà mạng SMS (mã KHÔNG trả về web/mobile).
# OTP_DELIVERY=console -> chỉ in ra log server, không trả mã về client.
OTP_DELIVERY=sms
SMS_PROVIDER=speedsms,esms   # thử lần lượt từ trái sang phải; 1 nhà mạng lỗi thì tự chuyển sang nhà mạng kế tiếp
# eSMS.vn
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=
ESMS_SMS_TYPE=8      # 8 = tin cố định giá rẻ (không cần brandname); 2 = CSKH brandname (phải có ESMS_BRANDNAME đã kích hoạt)
# SpeedSMS.vn
SPEEDSMS_ACCESS_TOKEN=
SPEEDSMS_SMS_TYPE=2   # 2 = đầu số ngẫu nhiên (không cần brandname); 3 = brandname; 4 = brandname mặc định Verify/Notify
SPEEDSMS_SENDER=
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Thanh toán VNPAY (sandbox) ----------
# VNPAY_RETURN_URL: để TRỐNG (hoặc 'auto') -> backend tự dựng từ địa chỉ server đang được gọi, vd. http://localhost:3000/payment/vnpay/callback
# hoặc http://<IP-LAN>:3000/payment/vnpay/callback khi test bằng điện thoại thật. Khách thanh toán xong sẽ được VNPAY chuyển về ĐÚNG backend này.
# Khi có domain thật (https) thì điền đầy đủ URL, hoặc đặt PUBLIC_BASE_URL=https://domain-cua-ban.
# LƯU Ý: không để trỏ sang domain của hệ thống khác (vd. app-dev.swift247.vn) - VNPAY sẽ chuyển khách về đó và booking không bao giờ được xác nhận.
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=
# PUBLIC_BASE_URL=
# Return URL của luồng đơn hàng/cargo - app vé máy bay chưa dùng, giữ để cấu hình sẵn
VNPAY_RETURN_URL_CARGO=https://app-dev.swift247.vn/order-bill/confirmation
VNPAY_HASH_SECRET=doi-thanh-chuoi-bi-mat-vnpay-cua-ban
VNPAY_BRAND_CODE=QA91LHJY
VNPAY_CURRENCY=VND
VNPAY_VERSION=2.1.0
# Chỉ đặt khi VNPAY yêu cầu gửi kèm vnp_SecureHashType (vd. HmacSHA512); mặc định để trống
VNPAY_SECURE_HASH_TYPE=
VNPAY_EXPIRE_MINUTES=15
# Đặt false khi chạy thật để tắt thanh toán "demo" (không trả tiền vẫn xác nhận vé)
ALLOW_DEMO_PAYMENT=true

# ---------- Check-in trực tuyến ----------
# Mở check-in trước giờ khởi hành N giờ, đóng trước giờ khởi hành M phút
CHECKIN_OPEN_HOURS=24
CHECKIN_CLOSE_MINUTES=60

# ---------- SkyJoy (khách hàng thân thiết) ----------
SKYJOY_EARN_PER_VND=10000      # cứ X đồng thực trả được 1 điểm
SKYJOY_POINT_VALUE=100         # 1 điểm = X đồng khi dùng điểm
SKYJOY_MIN_REDEEM=100          # dùng tối thiểu X điểm mỗi lần
SKYJOY_MAX_REDEEM_RATIO=0.5    # điểm giảm tối đa 50% giá trị đơn (sau khuyến mãi)
SKYJOY_TIER_SILVER=1000        # điểm tích lũy 12 tháng để lên hạng Bạc
SKYJOY_TIER_GOLD=3000
SKYJOY_TIER_DIAMOND=6000
